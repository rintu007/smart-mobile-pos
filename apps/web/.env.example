# Copy to .env.local and fill in with a real Supabase project's values.
# Never commit .env.local — see docs/12-security/secrets-management.md.

# Supabase project (create one at https://supabase.com — free tier is enough for local dev,
# per docs/16-milestones/... and docs/12-security/secrets-management.md's free-tier posture)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma / Postgres — two URLs, per docs/11-api/rate-limiting.md §3:
# DATABASE_URL is the pooled (Supavisor, transaction-mode) connection used at runtime.
# DIRECT_URL is the direct connection Prisma needs for migrations only.
DATABASE_URL=
DIRECT_URL=
