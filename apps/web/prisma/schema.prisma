// Built incrementally, module-by-module, per docs/17-sprints/backlog.md — this file is not
// docs/07-database/schema-server.md's full 22-table schema yet, by design. So far: `tenants`/
// `users` (Sprint 01, Custom Access Token Hook), `stores` (Sprint 02, Company & Store Setup),
// `products` (Sprint 04, name/price-only M0 slice), `sales`/`sale_line_items`/`sale_payments`
// (Sprint 05, cash-only M0 slice — see docs/modules/pos/specification.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// The top-level tenant-isolation boundary. One row per business account.
/// docs/07-database/schema-server.md — Context 1, `tenants`. Tier 1 (soft delete).
model Tenant {
  id            String    @id @db.Uuid
  name          String
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // `createdBy` intentionally has no FK to `users` here in Prisma's declarative schema: a brand
  // new tenant and its first user are created in the same transaction, before either row exists
  // for the other to reference (`tenants.created_by` -> `users.id`, `users.tenant_id` ->
  // `tenants.id`). Postgres resolves this cleanly with `DEFERRABLE INITIALLY DEFERRED` foreign
  // keys, checked at COMMIT rather than per-statement — Prisma's schema DSL has no keyword for
  // this, so the constraint itself is added via a hand-edited follow-up migration once a real
  // database exists (`prisma migrate dev --create-only`, then add the FK with DEFERRABLE by hand).
  // Found during Sprint 01 implementation, not anticipated in Phase 07 — worth an ADR once the
  // first real migration lands. Both this FK and `User.tenant`'s below use `ON DELETE NO ACTION`,
  // not `RESTRICT` — Postgres only allows a deferred check on `NO ACTION`, never on `RESTRICT`,
  // regardless of the `DEFERRABLE INITIALLY DEFERRED` marker (a mistake the first migration made
  // and a follow-up migration corrected).
  createdBy     String    @map("created_by") @db.Uuid

  users    User[]
  stores   Store[]
  products Product[]
  sales    Sale[]

  @@map("tenants")
}

/// A physical outlet. V1 creates exactly one per tenant, never shown in the UI.
/// docs/07-database/schema-server.md — Context 1, `stores`. Tier 1.
model Store {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String
  address       String?
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String    @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // NOT part of the deferred tenant<->user pair above (Tenant.createdBy, User.tenant) -- this is
  // an ordinary, non-deferred FK. In any transaction creating a tenant/store/user together, `user`
  // must be inserted before `store` for this reason. Found the hard way in Sprint 02
  // (docs/18-implementation/implementation-log.md, 2026-08-01) when the insert order assumed the
  // whole tenant/store/user set was deferred just because two of its tables are.
  user   User   @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  sales  Sale[]

  @@index([tenantId])
  @@map("stores")
}

/// An application user, linked to a Supabase Auth identity via `authUserId`.
/// docs/07-database/schema-server.md — Context 1, `users`. Tier 1.
model User {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  authUserId    String    @unique @map("auth_user_id") @db.Uuid
  displayName   String    @map("display_name")
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String    @map("created_by") @db.Uuid

  // `onDelete: NoAction`, not `Restrict` — Postgres does not allow a `RESTRICT` foreign key to
  // actually be deferred (only `NO ACTION` supports it), even when marked `DEFERRABLE INITIALLY
  // DEFERRED`. This matters for this exact relation since it's half of the tenant/user circular
  // bootstrapping pair — found when a hard-delete of test fixtures failed immediately instead of
  // deferring to commit. See implementation-log.md's 2026-08-01 entry.
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction)
  storesOwned     Store[]
  productsCreated Product[]
  salesCreated    Sale[]

  @@index([tenantId])
  @@map("users")
}

/// M0-minimal slice of docs/07-database/schema-server.md's `products` table — name/price only.
/// `category_id`/`unit_id`/`sku`/`barcode`/`hsn_sac_code`/`deactivated_at` are real columns in the
/// full V1 design but are added once Categories/Units (M1 — backlog.md's own scope split) exist for
/// the first two to reference, per docs/modules/products/specification.md §1/§3.
model Product {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  name            String
  /// BIGINT per ADR-0006 (money as integer minor units) — matches schema-server.md exactly, unlike
  /// the mobile Drift schema's deliberate `int64→int` simplification (Sprint 03), since Prisma/
  /// Postgres BigInt has no equivalent web-JS-precision reason to deviate from the approved design.
  priceMinorUnits BigInt    @map("price_minor_units")
  deactivatedAt   DateTime? @map("deactivated_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy       String    @map("created_by") @db.Uuid

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user          User           @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  saleLineItems SaleLineItem[]

  @@index([tenantId])
  @@map("products")
}

/// M0-minimal slice of docs/07-database/schema-server.md's `sales` table — cash-only, no
/// discount/tax. `trading_day_id`/`device_id`/`customer_id`/`canonical_invoice_number`/
/// `tax_registration_type_at_sale`/`tax_total_minor_units`/`discount_total_minor_units` are real
/// columns in the full V1 design but are added once Trading Day/device-registration/Customers/
/// tax-and-discount (M1/M2) exist, per docs/modules/pos/specification.md §1/§3.
model Sale {
  id                       String   @id @db.Uuid
  tenantId                 String   @map("tenant_id") @db.Uuid
  storeId                  String   @map("store_id") @db.Uuid
  /// Always 'completed' this sprint — draft/held/cancelled are real server states a future
  /// milestone's UI produces (hold/resume is M2 scope).
  status                   String
  provisionalInvoiceNumber String   @map("provisional_invoice_number")
  /// BigInt, matching schema-server.md's BIGINT exactly — same reasoning as Product.priceMinorUnits.
  subtotalMinorUnits       BigInt   @map("subtotal_minor_units")
  grandTotalMinorUnits     BigInt   @map("grand_total_minor_units")
  completedAt              DateTime @map("completed_at") @db.Timestamptz
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy                String   @map("created_by") @db.Uuid

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  store     Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  user      User           @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  lineItems SaleLineItem[]
  payments  SalePayment[]

  @@index([tenantId])
  @@map("sales")
}

/// M0-minimal slice of docs/07-database/schema-server.md's `sale_line_items` — omits `variant_id`
/// (V2+ stub), `hsn_sac_code_at_sale`/`tax_rate_basis_points`/`line_discount_minor_units`/
/// `line_tax_minor_units` (M2 scope, see Sale's comment above).
model SaleLineItem {
  id                  String @id @db.Uuid
  saleId              String @map("sale_id") @db.Uuid
  productId           String @map("product_id") @db.Uuid
  /// NUMERIC(14,3) on schema-server.md; Int here — M0 rejects fractional quantities entirely
  /// (docs/modules/pos/specification.md §2, since Units doesn't exist yet to say whether a
  /// product allows them), so no fixed-point representation is needed yet either.
  quantity            Int
  unitPriceMinorUnits BigInt @map("unit_price_minor_units")
  lineTotalMinorUnits BigInt @map("line_total_minor_units")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@map("sale_line_items")
}

/// M0 is cash-only (docs/modules/pos/specification.md §2) — `method`'s `CHECK` still allows the
/// full server enum since it costs nothing extra, matching Products' precedent, but only `'cash'`
/// rows are written until Split Payment (M2) exists.
model SalePayment {
  id               String @id @db.Uuid
  saleId           String @map("sale_id") @db.Uuid
  method           String
  amountMinorUnits BigInt @map("amount_minor_units")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@map("sale_payments")
}
