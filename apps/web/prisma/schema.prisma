// Built incrementally, module-by-module, per docs/17-sprints/backlog.md — this file is not
// docs/07-database/schema-server.md's full 22-table schema yet, by design. So far: `tenants`/
// `users` (Sprint 01, Custom Access Token Hook), `stores` (Sprint 02, Company & Store Setup),
// `products` (Sprint 04, name/price-only M0 slice), `sales`/`sale_line_items`/`sale_payments`
// (Sprint 05, cash-only M0 slice — see docs/modules/pos/specification.md).

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 removed `url`/`directUrl` from the datasource block entirely — both connection strings
// now live in `prisma.config.ts` (CLI/migrate) and `core/db/client.ts` (runtime, via the `pg`
// driver adapter). See https://pris.ly/d/config-datasource.
datasource db {
  provider = "postgresql"
}

/// The top-level tenant-isolation boundary. One row per business account.
/// docs/07-database/schema-server.md — Context 1, `tenants`. Tier 1 (soft delete).
model Tenant {
  id            String    @id @db.Uuid
  name          String
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // `createdBy` intentionally has no FK to `users` here in Prisma's declarative schema: a brand
  // new tenant and its first user are created in the same transaction, before either row exists
  // for the other to reference (`tenants.created_by` -> `users.id`, `users.tenant_id` ->
  // `tenants.id`). Postgres resolves this cleanly with `DEFERRABLE INITIALLY DEFERRED` foreign
  // keys, checked at COMMIT rather than per-statement — Prisma's schema DSL has no keyword for
  // this, so the constraint itself is added via a hand-edited follow-up migration once a real
  // database exists (`prisma migrate dev --create-only`, then add the FK with DEFERRABLE by hand).
  // Found during Sprint 01 implementation, not anticipated in Phase 07 — worth an ADR once the
  // first real migration lands. Both this FK and `User.tenant`'s below use `ON DELETE NO ACTION`,
  // not `RESTRICT` — Postgres only allows a deferred check on `NO ACTION`, never on `RESTRICT`,
  // regardless of the `DEFERRABLE INITIALLY DEFERRED` marker (a mistake the first migration made
  // and a follow-up migration corrected).
  createdBy     String    @map("created_by") @db.Uuid

  users                  User[]
  stores                 Store[]
  products               Product[]
  sales                  Sale[]
  stockMovements         StockMovement[]
  auditLogEntries        AuditLog[]
  categories             Category[]
  units                  Unit[]
  userStoreRoles         UserStoreRole[]
  invoiceSequences       InvoiceSequence[]
  shopSettings           ShopSettings?
  tradingDays            TradingDay[]
  customers              Customer[]
  returns                Return[]
  customerFieldConflicts CustomerFieldConflict[]

  @@map("tenants")
}

/// A physical outlet. V1 creates exactly one per tenant, never shown in the UI.
/// docs/07-database/schema-server.md — Context 1, `stores`. Tier 1.
model Store {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String
  address       String?
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String    @map("created_by") @db.Uuid

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // NOT part of the deferred tenant<->user pair above (Tenant.createdBy, User.tenant) -- this is
  // an ordinary, non-deferred FK. In any transaction creating a tenant/store/user together, `user`
  // must be inserted before `store` for this reason. Found the hard way in Sprint 02
  // (docs/18-implementation/implementation-log.md, 2026-08-01) when the insert order assumed the
  // whole tenant/store/user set was deferred just because two of its tables are.
  user            User            @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  sales           Sale[]
  stockMovements  StockMovement[]
  auditLogEntries AuditLog[]
  userStoreRoles  UserStoreRole[]
  tradingDays     TradingDay[]
  returns         Return[]

  @@index([tenantId])
  @@map("stores")
}

/// An application user, linked to a Supabase Auth identity via `authUserId`.
/// docs/07-database/schema-server.md — Context 1, `users`. Tier 1.
model User {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  authUserId    String    @unique @map("auth_user_id") @db.Uuid
  displayName   String    @map("display_name")
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String    @map("created_by") @db.Uuid

  // `onDelete: NoAction`, not `Restrict` — Postgres does not allow a `RESTRICT` foreign key to
  // actually be deferred (only `NO ACTION` supports it), even when marked `DEFERRABLE INITIALLY
  // DEFERRED`. This matters for this exact relation since it's half of the tenant/user circular
  // bootstrapping pair — found when a hard-delete of test fixtures failed immediately instead of
  // deferring to commit. See implementation-log.md's 2026-08-01 entry.
  tenant                          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: NoAction)
  storesOwned                     Store[]
  productsCreated                 Product[]
  salesCreated                    Sale[]
  stockMovementsCreated           StockMovement[]
  auditLogEntriesActed            AuditLog[]
  categoriesCreated               Category[]
  unitsCreated                    Unit[]
  roleAssignments                 UserStoreRole[]         @relation("UserStoreRoleUser")
  roleAssignmentsMade             UserStoreRole[]         @relation("UserStoreRoleAssigner")
  tradingDaysCreated              TradingDay[]            @relation("TradingDayCreator")
  tradingDaysReopened             TradingDay[]            @relation("TradingDayReopener")
  customersCreated                Customer[]
  customersUpdated                Customer[]              @relation("CustomerUpdatedBy")
  returnsCreated                  Return[]                @relation("ReturnCreator")
  returnsApproved                 Return[]                @relation("ReturnApprover")
  fieldConflictsAsCurrentSetter   CustomerFieldConflict[] @relation("ConflictCurrentSetBy")
  fieldConflictsAsAttemptedSetter CustomerFieldConflict[] @relation("ConflictAttemptedSetBy")
  fieldConflictsResolved          CustomerFieldConflict[] @relation("ConflictResolvedBy")
  devicesOwned                    Device[]                @relation("DeviceUser")
  devicesRevoked                  Device[]                @relation("DeviceRevoker")
  devicesRegistered               Device[]                @relation("DeviceCreatedBy")

  @@index([tenantId])
  @@map("users")
}

/// docs/07-database/schema-server.md's `devices` table — Sprint 43's OWASP checklist flagged this
/// as a real, unaddressed gap: authorisation-model.md §2's step 2 (device revocation) has never
/// been implemented, no `devices` table existed in code. Built Sprint 55. No direct `tenant_id`
/// column, per that section's own design ("Tenant scoping: tenant-scoped (via `user_id`)") — RLS
/// joins through `user_id` to `users.tenant_id`, the same parent-join shape
/// `sale_line_items`/`sale_payments`/`return_line_items` already use, just via `users` instead of
/// `sales`/`returns` (see `supabase/sql/019_rls_devices.sql`). `id` is server-generated
/// (`randomUUID()` at register-device time, matching `InvoiceSequence`'s own precedent for a row
/// created by server logic rather than an offline client write) — `clientDeviceId` is the actual
/// client-generated, dedup-key field ADR-0007 concerns itself with.
model Device {
  id             String    @id @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  clientDeviceId String    @map("client_device_id")
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  revokedBy      String?   @map("revoked_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy      String    @map("created_by") @db.Uuid

  user    User  @relation("DeviceUser", fields: [userId], references: [id], onDelete: Cascade)
  revoker User? @relation("DeviceRevoker", fields: [revokedBy], references: [id], onDelete: SetNull)
  creator User  @relation("DeviceCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([userId, clientDeviceId])
  @@index([userId])
  @@map("devices")
}

/// docs/07-database/schema-server.md's `user_store_roles` table — assigns a role
/// (cashier/manager/owner) to a user at a store. Module: Roles & Permissions (Sprint 23,
/// backlog.md item 7). No `CHECK` on `role`, matching StockMovement.movementType's own precedent
/// of relying on application code (Zod), not a hand-edited migration, for a small fixed-value set.
/// The documented partial index `(user_id, store_id) WHERE revoked_at IS NULL` is built as an
/// ordinary index here instead — Prisma's schema DSL has no partial-index syntax, and this is a
/// size/speed optimisation, not a correctness requirement, at this project's current scale.
model UserStoreRole {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  storeId    String    @map("store_id") @db.Uuid
  role       String
  assignedBy String    @map("assigned_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user     User   @relation("UserStoreRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  assigner User   @relation("UserStoreRoleAssigner", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@index([userId, storeId])
  @@map("user_store_roles")
}

/// M1 Sprint 19's extension of docs/07-database/schema-server.md's `products` table —
/// `category_id`/`unit_id`/`sku`/`barcode`/`hsn_sac_code` added (backlog.md item 3), all nullable
/// rather than the full design's `NOT NULL`, per docs/modules/products/specification.md §1's
/// dated correction: 4 real products already exist in production without them, and mobile's
/// `/catalogue/add` (the only place a human picks a category/unit) can't supply them until
/// backlog.md item 4 ships. `deactivated_at` already existed from the M0-minimal slice.
model Product {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  categoryId      String?   @map("category_id") @db.Uuid
  unitId          String?   @map("unit_id") @db.Uuid
  name            String
  sku             String?
  barcode         String?
  hsnSacCode      String?   @map("hsn_sac_code")
  /// BIGINT per ADR-0006 (money as integer minor units) — matches schema-server.md exactly, unlike
  /// the mobile Drift schema's deliberate `int64→int` simplification (Sprint 03), since Prisma/
  /// Postgres BigInt has no equivalent web-JS-precision reason to deviate from the approved design.
  priceMinorUnits BigInt    @map("price_minor_units")
  deactivatedAt   DateTime? @map("deactivated_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy       String    @map("created_by") @db.Uuid

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit           Unit?           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  user           User            @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  saleLineItems  SaleLineItem[]
  stockMovements StockMovement[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId])
  /// Sprint 70 — schema-server.md has documented a `(tenant_id, category_id)` index for the real,
  /// live `categoryId` filter `GET /api/v1/products` (products/repository.ts#listProducts) applies
  /// since it was written; never actually built.
  @@index([tenantId, categoryId])
  @@map("products")
}

/// M0-minimal slice of docs/07-database/schema-server.md's `sales` table — cash-only, no
/// discount/tax. `device_id`/`customer_id`/`tax_registration_type_at_sale`/`tax_total_minor_units`/
/// `discount_total_minor_units` are real columns in the full V1 design but are added once
/// device-registration/Customers/tax-and-discount (M2) exist, per docs/modules/pos/specification.md §1/§3.
model Sale {
  id                        String   @id @db.Uuid
  tenantId                  String   @map("tenant_id") @db.Uuid
  storeId                   String   @map("store_id") @db.Uuid
  /// Added Sprint 26 (backlog.md M2 item 2) — nullable, linked when the client supplies it, but not
  /// yet required: docs/modules/trading-day/specification.md §1's named, dated decision not to gate
  /// POST /sales on an open trading day until the mobile till screen is updated to open one first,
  /// to avoid regressing the one live, working end-to-end sale flow this project has (Sprint 16).
  tradingDayId              String?  @map("trading_day_id") @db.Uuid
  /// Added Sprint 31 (backlog.md M3 item 1) — nullable, matching schema-server.md's own documented
  /// column exactly (a sale outlives a customer record being deactivated). Not yet populated by any
  /// code path: POST /sales doesn't accept it yet, that's M3 item 2's mobile-checkout-wiring scope
  /// (docs/modules/customers/specification.md §1). Built now so item 2 has the column to write to.
  customerId                String?  @map("customer_id") @db.Uuid
  /// Always 'completed' this sprint — draft/held/cancelled are real server states a future
  /// milestone's UI produces (hold/resume is M2 scope).
  status                    String
  provisionalInvoiceNumber  String   @map("provisional_invoice_number")
  /// Added Sprint 24 (backlog item 8) — ADR-0008's canonical half. Assigned atomically, in the
  /// same transaction as the sale itself, via InvoiceSequence. Nullable only to match
  /// schema-server.md's own documented column exactly — in practice never null for a stored sale,
  /// since this server never persists a sale row until it has already "arrived" (see
  /// docs/modules/sales-invoices/specification.md §1's dated clarification).
  canonicalInvoiceNumber    BigInt?  @map("canonical_invoice_number")
  /// The financial year canonicalInvoiceNumber is scoped within (identifiers.md §3) — derived
  /// from completedAt at assignment time, "2026" for FY2026-27, matching mobile's own
  /// InvoiceNumberGenerator._financialYearFor string format exactly.
  financialYear             String?  @map("financial_year")
  /// BigInt, matching schema-server.md's BIGINT exactly — same reasoning as Product.priceMinorUnits.
  /// Sprint 27 correction: means post-discount, pre-tax (money-and-tax.md's always-fixed formula),
  /// not the pre-discount raw sum this column silently held before Discount existed to diverge it.
  subtotalMinorUnits        BigInt   @map("subtotal_minor_units")
  /// Added Sprint 27 (backlog.md M2 item 3) — DR-011/DR-012, docs/modules/pos/specification.md §2.
  discountTotalMinorUnits   BigInt   @default(0) @map("discount_total_minor_units")
  /// Added Sprint 28 (backlog.md M2 item 4) — DR-008, never independently rounded (sum of
  /// already-rounded line taxes).
  taxTotalMinorUnits        BigInt   @default(0) @map("tax_total_minor_units")
  /// Snapshot of shop_settings.tax_mode at creation time, per schema-server.md's own reasoning ("a
  /// shop's tax status can change after old sales exist") — never a live join. Nullable to match
  /// every other Sprint 24-28 addition's own precedent (real pre-existing rows have no value to
  /// backfill); always populated by every code path that creates a sale from this sprint onward.
  taxRegistrationTypeAtSale String?  @map("tax_registration_type_at_sale")
  grandTotalMinorUnits      BigInt   @map("grand_total_minor_units")
  completedAt               DateTime @map("completed_at") @db.Timestamptz
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy                 String   @map("created_by") @db.Uuid

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  store      Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  user       User           @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  tradingDay TradingDay?    @relation(fields: [tradingDayId], references: [id], onDelete: Restrict)
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lineItems  SaleLineItem[]
  payments   SalePayment[]
  returns    Return[]

  // Sprint 24: provisional-number uniqueness closes a real, pre-existing gap (identifiers.md §2
  // already documented it as a business-meaningful identifier, but M0 never enforced it).
  // Canonical-number uniqueness matches schema-server.md's own documented scope exactly.
  @@unique([tenantId, provisionalInvoiceNumber])
  @@unique([tenantId, financialYear, canonicalInvoiceNumber])
  @@index([tenantId, storeId, completedAt])
  /// Sprint 70 — schema-server.md has documented a `(customer_id)` index for
  /// `listPurchaseHistory`'s real, live query since it was written; never actually built. Composite
  /// on the query's real shape (WHERE tenantId+customerId, ORDER BY completedAt DESC), a more
  /// precise index than the doc's own bare `customer_id` column ever specified.
  @@index([tenantId, customerId, completedAt])
  @@map("sales")
}

/// New this sprint (backlog item 8) — the atomic counter backing ADR-0008's canonical
/// invoice-number assignment. Not itself in schema-server.md's table list: that document only
/// says canonical_invoice_number is "unique per (tenant_id, financial_year)," leaving the
/// mechanism open ("via a database sequence or an equivalent atomic counter"). A per-tenant
/// Postgres SEQUENCE object isn't practical for an unbounded number of tenants; this table-based
/// counter is the ADR-sanctioned equivalent.
model InvoiceSequence {
  id            String @id @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  financialYear String @map("financial_year")
  nextValue     BigInt @map("next_value")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, financialYear])
  @@map("invoice_sequences")
}

/// docs/07-database/schema-server.md's `shop_settings` (Context 7) — one row per tenant, `tenant_id`
/// is its own primary key. `taxRateBasisPoints` is a Sprint 25 correction, not in the original
/// Phase 07 design: schema-server.md never named where DR-008's tax_rate actually comes from. V1
/// applies one shop-wide flat rate to every line, not a per-product/per-HSN table — see
/// docs/07-database/money-and-tax.md §2a. `printerConfig`/`receiptTemplateConfig` exist as columns
/// (matching schema-server.md exactly) but `PATCH /settings` rejects setting either this sprint —
/// no printer-pairing/receipt-template flow exists yet, docs/modules/settings/specification.md §1.
model ShopSettings {
  tenantId                                String   @id @map("tenant_id") @db.Uuid
  taxMode                                 String   @map("tax_mode")
  taxRateBasisPoints                      Int      @default(0) @map("tax_rate_basis_points")
  pricingMode                             String   @map("pricing_mode")
  roundingRule                            String   @map("rounding_rule")
  currencyCode                            String   @default("INR") @map("currency_code")
  discountAutoApprovalThresholdMinorUnits BigInt   @map("discount_auto_approval_threshold_minor_units")
  returnAutoApprovalThresholdMinorUnits   BigInt   @map("return_auto_approval_threshold_minor_units")
  /// Added Sprint 37 (backlog.md M4 item 2) — a real, blocking gap found starting Reports: BR-024/
  /// BR-045 require the low-stock report's threshold to be "configurable, per-product or shop-wide,"
  /// and no such field existed anywhere in this schema. A single shop-wide default, matching
  /// taxRateBasisPoints' own V1-simplification precedent (per-product granularity deferred, named).
  lowStockThresholdQuantity               Int      @default(5) @map("low_stock_threshold_quantity")
  printerConfig                           Json?    @map("printer_config")
  receiptTemplateConfig                   Json?    @map("receipt_template_config")
  createdAt                               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy                               String   @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("shop_settings")
}

/// docs/07-database/schema-server.md's `trading_days` (Context 5) minus `device_id` — Sprint 26
/// (backlog.md M2 item 2) scopes "is there an open day" by (tenant_id, store_id) instead, a named,
/// dated deviation: no `devices` table exists, and offline-workflows.md's own Finding 2 already
/// frames per-device as a sidestep of the real "one physical drawer" model, not the more-correct
/// one. See docs/modules/trading-day/specification.md §1 for the full reasoning. The one-open-day-
/// per-store invariant is enforced by a hand-edited partial unique index in this migration
/// (`trading_days_one_open_per_store`), not expressible in Prisma's schema DSL — a correctness
/// guard against a real race (two concurrent `open` calls), not merely a query-speed optimisation.
model TradingDay {
  id                      String    @id @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  storeId                 String    @map("store_id") @db.Uuid
  /// 'open' | 'closed' — no CHECK constraint, matching Sale.status/ShopSettings.taxMode's own
  /// precedent of relying on application code (Zod) for a small fixed-value set.
  status                  String
  startingFloatMinorUnits BigInt    @map("starting_float_minor_units")
  countedCashMinorUnits   BigInt?   @map("counted_cash_minor_units")
  expectedCashMinorUnits  BigInt?   @map("expected_cash_minor_units")
  varianceMinorUnits      BigInt?   @map("variance_minor_units")
  closedAt                DateTime? @map("closed_at") @db.Timestamptz
  reopenedAt              DateTime? @map("reopened_at") @db.Timestamptz
  reopenedBy              String?   @map("reopened_by") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy               String    @map("created_by") @db.Uuid

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  creator  User   @relation("TradingDayCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  reopener User?  @relation("TradingDayReopener", fields: [reopenedBy], references: [id], onDelete: SetNull)
  sales    Sale[]

  @@index([tenantId, storeId, status])
  @@map("trading_days")
}

/// M0-minimal slice of docs/07-database/schema-server.md's `sale_line_items` — omits `variant_id`
/// (V2+ stub), `hsn_sac_code_at_sale`/`tax_rate_basis_points`/`line_tax_minor_units` (M2 item 4).
/// `line_discount_minor_units` added Sprint 27 (M2 item 3).
model SaleLineItem {
  id                     String @id @db.Uuid
  saleId                 String @map("sale_id") @db.Uuid
  productId              String @map("product_id") @db.Uuid
  /// NUMERIC(14,3) on schema-server.md; Int here — M0 rejects fractional quantities entirely
  /// (docs/modules/pos/specification.md §2, since Units doesn't exist yet to say whether a
  /// product allows them), so no fixed-point representation is needed yet either.
  quantity               Int
  unitPriceMinorUnits    BigInt @map("unit_price_minor_units")
  lineDiscountMinorUnits BigInt @default(0) @map("line_discount_minor_units")
  /// Added Sprint 28 (backlog.md M2 item 4) — a snapshot of shop_settings.tax_rate_basis_points at
  /// the moment this line was priced, matching schema-server.md's own per-line snapshot design
  /// (a later shop-wide rate change must never alter an already-completed sale's own line).
  taxRateBasisPoints     Int    @default(0) @map("tax_rate_basis_points")
  lineTaxMinorUnits      BigInt @default(0) @map("line_tax_minor_units")
  lineTotalMinorUnits    BigInt @map("line_total_minor_units")

  sale            Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnLineItems ReturnLineItem[]

  @@index([saleId])
  @@map("sale_line_items")
}

/// M0 is cash-only (docs/modules/pos/specification.md §2) — `method`'s `CHECK` still allows the
/// full server enum since it costs nothing extra, matching Products' precedent, but only `'cash'`
/// rows are written until Split Payment (M2) exists.
model SalePayment {
  id               String @id @db.Uuid
  saleId           String @map("sale_id") @db.Uuid
  method           String
  amountMinorUnits BigInt @map("amount_minor_units")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@map("sale_payments")
}

/// Still-partial slice of docs/07-database/schema-server.md's `stock_movements` table.
/// `variant_id`/`batch_id`/`serial_number` (V2/V4 stubs) remain out of scope —
/// docs/modules/inventory/specification.md §3. `device_id` is omitted, the same M0-wide gap `Sale`
/// already has (device registration isn't built yet, module registry) — `createdBy` substitutes
/// for attribution, matching every other table's own precedent.
model StockMovement {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  /// NUMERIC(14,3) on schema-server.md; Int here — the same fractional-quantity deferral
  /// SaleLineItem.quantity already established (Units' allows_fractional flag isn't wired into any
  /// quantity field yet, this one included). Signed: positive for opening/most corrective
  /// adjustments, negative for sale/most reductive adjustments.
  quantityDelta Int      @map("quantity_delta")
  /// `NOT NULL CHECK (movement_type IN ('opening','sale','return','adjustment'))` on
  /// schema-server.md — no CHECK added here, matching Sale.status/SalePayment.method's own
  /// precedent of relying on application code rather than a hand-edited migration for this.
  movementType  String   @map("movement_type")
  /// Added Sprint 22 (backlog.md item 6). `NOT NULL` only when `movementType = 'adjustment'` on
  /// schema-server.md — enforced in the service layer (ADJUSTMENT_REASON_REQUIRED), not a Postgres
  /// CHECK, the same precedent movementType itself already set. One of a fixed five-value list
  /// (docs/modules/inventory/specification.md §2), not DB-enforced as an enum either.
  reasonCode    String?  @map("reason_code")
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String   @map("created_by") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([tenantId, storeId, productId])
  @@index([tenantId, storeId, createdAt])
  @@map("stock_movements")
}

/// M0-minimal slice of docs/07-database/schema-server.md's `audit_log` table — only the
/// `sale.completed` action is ever written this sprint (backlog.md item 8, DR-025's "Sale
/// completed" row). Every other audit-model.md §1 trigger (stock movements, returns, trading day,
/// role/device/settings/user changes) is out of scope — docs/modules/audit-log/specification.md
/// §1, including the now-visible gap that Sprint 11's stock movements have no audit coverage yet.
model AuditLog {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  storeId     String?  @map("store_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  store  Store? @relation(fields: [storeId], references: [id], onDelete: Restrict)
  actor  User   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_log")
}

/// M1 Sprint 17's minimal slice of docs/07-database/schema-server.md's `categories` table —
/// create+list only (backlog.md item 1). `deactivated_at`/`updated_at` are real columns in the
/// full V1 design but are added once `PATCH`/`DELETE /categories` land, per
/// docs/modules/categories/specification.md §3.
model Category {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String   @map("created_by") @db.Uuid

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user     User      @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  products Product[]

  @@index([tenantId])
  @@map("categories")
}

/// M1 Sprint 18's minimal slice of docs/07-database/schema-server.md's `units` table —
/// create+list only (backlog.md item 2), same cut as Category (Sprint 17). `deactivated_at`/
/// `updated_at` are real columns in the full V1 design but are added once `PATCH`/`DELETE /units`
/// land, per docs/modules/units/specification.md §3. `allowsFractional` is written now (schema-
/// server.md's own `NOT NULL DEFAULT false`) even though nothing enforces its immutability yet —
/// that enforcement (`UNIT_FRACTIONAL_FLAG_LOCKED`) is a `PATCH`-only concern, deferred with it.
model Unit {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String
  symbol           String
  allowsFractional Boolean  @default(false) @map("allows_fractional")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy        String   @map("created_by") @db.Uuid

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user     User      @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  products Product[]

  @@index([tenantId])
  @@map("units")
}

/// Sprint 31 (backlog.md M3 item 1) — docs/07-database/schema-server.md's `customers` table
/// (Context 4), built in full this sprint (unlike Category/Unit's create+list-only cut): `name`/
/// `phone` are both nullable at the schema level (CUSTOMER_IDENTIFIER_REQUIRED enforces "at least
/// one" at the application layer, not the database), `updatedAt` is included from the start (not
/// deferred the way Category/Unit's was) since M3 item 5's conflict-resolution merge policy needs
/// it as a real column — docs/modules/customers/specification.md §3. The
/// `(tenant_id, phone) WHERE deactivated_at IS NULL` uniqueness rule (the return-by-phone lookup,
/// FR-062, and PHONE_ALREADY_ASSIGNED's actual mechanism) is enforced by a hand-edited partial
/// unique index in this migration (`customers_tenant_id_phone_active_key`), not expressible in
/// Prisma's schema DSL — same TradingDay-precedent shape, not declared as `@@unique` below.
model Customer {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String?
  phone         String?
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz
  /// Sprint 46 (docs/12-security/privacy.md §4) — an erasure request anonymises this row (`name`/
  /// `phone` overwritten with `null`) rather than deleting it, so every historical
  /// `sales.customer_id` FK stays valid; `erasedAt` is the explicit state marker distinguishing
  /// "genuinely erased" from a customer who simply never had a name/phone set (both nullable at
  /// creation already), the same explicit-timestamp-over-inferred-state convention every other
  /// state transition in this schema already uses (`deactivatedAt`, `completedAt`, `resolvedAt`).
  erasedAt      DateTime? @map("erased_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy     String    @map("created_by") @db.Uuid
  /// Added Sprint 35 (backlog.md M3 item 5) — the actor of the most recent successful field
  /// application. Nullable: null for a customer never edited since creation (its own `createdBy`
  /// is attributed instead — docs/modules/customers/specification.md §1c). Feeds
  /// `customer_field_conflicts.current_set_by` at the moment a conflict is detected.
  updatedBy     String?   @map("updated_by") @db.Uuid

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user           User                    @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  updater        User?                   @relation("CustomerUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  sales          Sale[]
  fieldConflicts CustomerFieldConflict[]

  @@index([tenantId])
  @@map("customers")
}

/// Sprint 35 (backlog.md M3 item 5) — docs/modules/customers/specification.md §1c/§3. A field-edit
/// collision (conflict-resolution.md §3): the currently-applied value and the value a
/// later-arriving edit wanted instead, both attributed to their own actor, awaiting a Manager/Owner
/// decision. `current_value`/`attempted_value` nullable, mirroring `customers.name`/`phone`'s own
/// nullability — a field's "value" can legitimately be null.
model CustomerFieldConflict {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  customerId     String    @map("customer_id") @db.Uuid
  /// 'name' | 'phone' — no CHECK added here, matching every other small-fixed-value-set column's
  /// own precedent (Sale.status, StockMovement.movementType, ...) of relying on application code.
  field          String
  currentValue   String?   @map("current_value")
  currentSetBy   String    @map("current_set_by") @db.Uuid
  attemptedValue String?   @map("attempted_value")
  attemptedSetBy String    @map("attempted_set_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz
  resolvedValue  String?   @map("resolved_value")
  resolvedBy     String?   @map("resolved_by") @db.Uuid

  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  currentSetByUser   User     @relation("ConflictCurrentSetBy", fields: [currentSetBy], references: [id], onDelete: Restrict)
  attemptedSetByUser User     @relation("ConflictAttemptedSetBy", fields: [attemptedSetBy], references: [id], onDelete: Restrict)
  resolvedByUser     User?    @relation("ConflictResolvedBy", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, resolvedAt])
  @@map("customer_field_conflicts")
}

/// Sprint 33 (backlog.md M3 item 3) — docs/07-database/schema-server.md's `returns` table
/// (Context 6), adjusted per two dated corrections in docs/modules/returns/specification.md §1:
/// (1) gains `createdAt`/`createdBy` — the documented column list never named them, but
/// `GET /returns`' own Cashier "own device only" scope (returns.md) is unimplementable without a
/// column recording who filed the return, the same `created_by`-as-device-substitute adaptation
/// `sales-invoices/specification.md` already made; (2) the documented separate
/// `client_operation_id UNIQUE` column is dropped — `id` alone is this table's idempotency key,
/// matching every other client-generated-id table's actual working mechanism (`sales`,
/// `trading_days`, `customers`), not a second, redundant uniqueness constraint with no precedent
/// elsewhere in this schema. `status` keeps the full five-value CHECK vocabulary for forward
/// compatibility even though only `pending_approval`/`completed`/`rejected` are ever written this
/// sprint (`initiated`/`approved` are documented-but-unreachable, the same shape
/// `movement_type: 'opening'` already established, Sprint 22).
model Return {
  id                    String    @id @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  storeId               String    @map("store_id") @db.Uuid
  originalSaleId        String    @map("original_sale_id") @db.Uuid
  /// 'pending_approval' | 'completed' | 'rejected' reachable this sprint — no CHECK added here,
  /// matching Sale.status/TradingDay.status's own precedent of relying on application code (Zod)
  /// for a small fixed-value set.
  status                String
  refundTotalMinorUnits BigInt    @map("refund_total_minor_units")
  approvedBy            String?   @map("approved_by") @db.Uuid
  completedAt           DateTime? @map("completed_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy             String    @map("created_by") @db.Uuid

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  store        Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  originalSale Sale             @relation(fields: [originalSaleId], references: [id], onDelete: Restrict)
  approver     User?            @relation("ReturnApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  creator      User             @relation("ReturnCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  lineItems    ReturnLineItem[]

  @@index([originalSaleId])
  @@index([tenantId, storeId, status])
  @@index([tenantId, createdAt])
  @@map("returns")
}

/// docs/07-database/schema-server.md's `return_line_items` table (Context 6). `quantity` is `Int`,
/// not `NUMERIC(14,3)` — matches `SaleLineItem.quantity`'s own already-established M0 simplification
/// (no fractional-quantity field exists anywhere in this schema yet). `id` is server-generated
/// (`randomUUID()`), unlike `returns.id` — a line item has no client-facing idempotency need of its
/// own, it's only ever identified through its parent return.
model ReturnLineItem {
  id                     String @id @db.Uuid
  returnId               String @map("return_id") @db.Uuid
  originalSaleLineItemId String @map("original_sale_line_item_id") @db.Uuid
  quantity               Int
  refundAmountMinorUnits BigInt @map("refund_amount_minor_units")

  return               Return       @relation(fields: [returnId], references: [id], onDelete: Restrict)
  originalSaleLineItem SaleLineItem @relation(fields: [originalSaleLineItemId], references: [id], onDelete: Restrict)

  @@index([originalSaleLineItemId])
  @@map("return_line_items")
}

/// Sprint 45 (docs/11-api/rate-limiting.md §1) — a fixed-window request counter, one row per
/// `(scope, window)` pair. Deliberately **not** a tenant-owned table: `key` already embeds
/// whichever scope it's protecting (`read:tenant:<id>`, `mutating:user:<id>`, `sync-push:user:<id>`)
/// as an opaque string this table itself never interprets, so it carries no `tenant_id` column and
/// needs no RLS policy — nothing outside `core/rate-limit/` ever queries it, and every value already
/// baked into `key` was resolved from an authenticated session before this table is touched. Postgres
/// (not an external service like Upstash Redis) per this project's standing free/open-source-first
/// constraint — the same reasoning that chose Dependabot over a paid scanner and GitHub's own board
/// automation over a third-party project-management tool.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(1)
  windowEnd DateTime @map("window_end") @db.Timestamptz

  @@index([windowEnd])
  @@map("rate_limit_buckets")
}
